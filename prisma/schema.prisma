// AMSMA Prisma Schema
// See docs/database.md for ERD and design decisions

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// COMMITTEE (Phase 3)
// ============================================================

enum CommitteeRole {
  FOUNDER_PATRON
  FOUNDER_PRESIDENT
  FIRST_PRESIDENT
  VICE_PRESIDENT
  SECRETARY
  TREASURER
  FOUNDER_MEMBER
}

model CommitteeMember {
  id                     String        @id @default(cuid())
  slug                   String        @unique
  name                   String
  email                  String        @unique
  role                   CommitteeRole
  title                  String
  canApproveApplications Boolean       @default(true)
  isTest                 Boolean       @default(false)
  createdAt              DateTime      @default(now())

  reviews    ApplicationReview[]
  portalUser PortalUser?

  @@index([isTest, canApproveApplications])
}

// ============================================================
// MEMBERSHIP APPLICATION FLOW (Phase 3)
// ============================================================

enum MembershipTier {
  ORDINARY_LARGE
  ORDINARY_REGULAR
  ASSOCIATE
  INSTITUTIONAL
}

enum ApplicationStatus {
  SUBMITTED // Just received, review invites being sent
  SPONSOR_REVIEW // Awaiting proposer and seconder endorsement
  COMMITTEE_REVIEW // Sponsor stage complete; 48-hour committee vote is open
  PAUSED_NO_QUORUM // Committee window ended without a decision; admin may extend
  ADMIN_REVIEW // Committee reached a result; admin must confirm and release it
  UNDER_REVIEW // Legacy value retained for existing applications
  APPROVED // Legacy approval state
  REJECTED // Confirmed rejection
  PAYMENT_PENDING // Approved, awaiting payment (same as APPROVED but clearer)
  ACTIVE // Paid, member is active
  EXPIRED // Approved but payment window elapsed
}

enum CommitteeResult {
  PENDING
  APPROVED
  REJECTED
  NO_QUORUM
}

model MembershipApplication {
  id            String            @id @default(cuid())
  applicationNo String            @unique // Human-friendly, e.g. AMSMA-2026-0001
  tier          MembershipTier
  status        ApplicationStatus @default(SUBMITTED)
  isTest        Boolean           @default(false)

  // Applicant / organisation
  organizationName String
  contactName      String
  contactEmail     String
  contactPhone     String
  addressLine      String
  city             String
  state            String
  pincode          String
  pan              String
  gstNumber        String?

  // Category-specific
  crushingCapacityMtMonth Int? // Ordinary only
  natureOfBusiness        String? // Associate / Institutional descriptor

  // Signatory (per Rules — authorized representative)
  signatoryName        String
  signatoryDesignation String
  signatoryEmail       String
  signatoryPhone       String

  // Supporting docs (Phase 3: cloud storage URL; Phase 5: R2 upload)
  companyProofUrl  String?
  companyProofType String? // 'incorporation' | 'gst_cert' | 'partnership_deed'

  // Proposer & Seconder (existing members — required per Q2)
  proposerName  String
  proposerEmail String
  seconderName  String
  seconderEmail String

  // Fees
  annualFeePaise  Int
  amountPaidPaise Int?

  // Payment
  paymentToken      String?   @unique // For /pay/[token] URL
  razorpayOrderId   String?
  razorpayPaymentId String?
  paidAt            DateTime?
  paymentLinkSentAt DateTime?
  paymentExpiresAt  DateTime?

  // Decision tracking
  submittedAt               DateTime        @default(now())
  sponsorReviewDeadlineAt   DateTime?
  committeeReviewStartedAt  DateTime?
  committeeReviewDeadlineAt DateTime?
  committeeResult           CommitteeResult @default(PENDING)
  decidedAt                 DateTime?
  rejectionReason           String?
  adminConfirmedAt          DateTime?
  adminConfirmedById        String?
  adminConfirmedBy          PortalUser?     @relation("AdminDecisions", fields: [adminConfirmedById], references: [id], onDelete: SetNull)
  adminNote                 String?

  reviews ApplicationReview[]

  @@index([status])
  @@index([tier])
  @@index([contactEmail])
  @@index([isTest, status])
}

enum ReviewDecision {
  PENDING
  APPROVE
  REJECT
}

enum ReviewPhase {
  SPONSOR
  COMMITTEE
}

model ApplicationReview {
  id                String                @id @default(cuid())
  applicationId     String
  application       MembershipApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  committeeMemberId String
  committeeMember   CommitteeMember       @relation(fields: [committeeMemberId], references: [id], onDelete: Cascade)

  // The token identifies the assigned review. Portal login is still required.
  token          String   @unique
  tokenExpiresAt DateTime

  phase       ReviewPhase    @default(COMMITTEE)
  decision    ReviewDecision @default(PENDING)
  comment     String?
  decidedAt   DateTime?
  emailSentAt DateTime?

  createdAt DateTime @default(now())

  @@unique([applicationId, committeeMemberId])
  @@index([token])
  @@index([applicationId, decision])
}

// ============================================================
// ACCESS-CONTROLLED COMMITTEE AND ADMIN PORTAL
// ============================================================

enum PortalRole {
  COMMITTEE
  ADMIN
  MEMBER
}

model PortalUser {
  id                String                  @id @default(cuid())
  email             String                  @unique
  name              String
  passwordHash      String? // Legacy field; email code login does not use passwords
  role              PortalRole
  active            Boolean                 @default(true)
  isTest            Boolean                 @default(false)
  forumPostingSuspended Boolean            @default(false)
  committeeMemberId String?                 @unique
  committeeMember   CommitteeMember?        @relation(fields: [committeeMemberId], references: [id], onDelete: SetNull)
  memberId          String?                 @unique
  member            Member?                 @relation(fields: [memberId], references: [id], onDelete: SetNull)
  sessions          PortalSession[]
  loginChallenges   PortalLoginChallenge[]
  adminDecisions    MembershipApplication[] @relation("AdminDecisions")
  auditEvents       AuditEvent[]
  forumTopics       ForumTopic[]
  forumPosts        ForumPost[]
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  lastLoginAt       DateTime?

  @@index([role, active])
}

model PortalSession {
  id        String     @id @default(cuid())
  tokenHash String     @unique
  userId    String
  user      PortalUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime   @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model PortalLoginChallenge {
  id         String     @id @default(cuid())
  userId     String
  user       PortalUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  email      String
  codeHash   String
  tokenHash  String     @unique
  returnPath String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int        @default(0)
  createdAt  DateTime   @default(now())

  @@index([email, createdAt])
  @@index([expiresAt])
}

model AuditEvent {
  id            String      @id @default(cuid())
  applicationId String?
  actorUserId   String?
  actorUser     PortalUser? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  event         String
  details       Json?
  createdAt     DateTime    @default(now())

  @@index([applicationId, createdAt])
  @@index([actorUserId, createdAt])
}

// ============================================================
// APPROVED MEMBERS (Register of Members per Rules Sec 4.iii)
// ============================================================

enum MemberStatus {
  ACTIVE
  EXPIRED
  TERMINATED
}

model Member {
  id                      String         @id @default(cuid())
  memberNo                String         @unique // AMSMA-M-0001
  applicationId           String         @unique // FK to originating application
  tier                    MembershipTier
  organizationName        String
  contactName             String
  email                   String         @unique
  phone                   String
  address                 String
  city                    String
  state                   String
  pan                     String
  gstNumber               String?
  crushingCapacityMtMonth Int?

  admittedAt DateTime     @default(now())
  expiresAt  DateTime // 12 months from admission
  status     MemberStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  portalUser PortalUser?

  @@index([status])
}

// ============================================================
// PRIVATE DISCUSSION FOR ACTIVE MEMBERS AND COMMITTEE
// ============================================================

enum ForumSpace {
  MEMBERS
  COMMITTEE
}

model ForumTopic {
  id         String      @id @default(cuid())
  space      ForumSpace
  isTest     Boolean     @default(false)
  title      String      @db.VarChar(160)
  authorId   String
  author     PortalUser  @relation(fields: [authorId], references: [id], onDelete: Restrict)
  posts      ForumPost[]
  isClosed   Boolean     @default(false)
  isHidden   Boolean     @default(false)
  isDeleted  Boolean     @default(false)
  isPinned   Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([isTest, space, isHidden, updatedAt])
  @@index([authorId, createdAt])
}

model ForumPost {
  id        String     @id @default(cuid())
  topicId   String
  topic     ForumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  authorId  String
  author    PortalUser @relation(fields: [authorId], references: [id], onDelete: Restrict)
  body      String     @db.Text
  isHidden  Boolean    @default(false)
  isDeleted Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([topicId, isHidden, createdAt])
  @@index([authorId, createdAt])
}

// ============================================================
// EVENTS (Phase 4 — placeholder)
// ============================================================

model Event {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  description   String   @db.Text
  location      String
  startDate     DateTime
  endDate       DateTime
  capacity      Int?
  priceInPaise  Int?
  isPublic      Boolean  @default(true)
  coverImageUrl String?

  // Optional circular / agenda / notice attached to the event
  attachmentId String?
  attachment   StoredFile? @relation("EventAttachment", fields: [attachmentId], references: [id])

  registrations EventRegistration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startDate])
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model EventRegistration {
  id           String  @id @default(cuid())
  eventId      String
  event        Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name         String
  email        String
  phone        String?
  organization String?

  razorpayOrderId   String?
  razorpayPaymentId String?
  amountPaid        Int?

  status    RegistrationStatus @default(PENDING)
  createdAt DateTime           @default(now())

  @@index([eventId, status])
}

// ============================================================
// CONTENT (Phase 5 — placeholder)
// ============================================================

enum PublicationCategory {
  ARTICLE
  REGULATION
  GOVT_LETTER
  CIRCULAR
  PRESENTATION
  OTHER
}

model Publication {
  id          String              @id @default(cuid())
  title       String
  description String?             @db.Text
  category    PublicationCategory @default(OTHER)

  fileId String
  file   StoredFile @relation("PublicationFile", fields: [fileId], references: [id], onDelete: Restrict)

  publishedAt   DateTime @default(now())
  isPublished   Boolean  @default(true)
  downloadCount Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, publishedAt])
  @@index([isPublished, publishedAt])
}

// ============================================================
// BLOG
// ============================================================

model BlogPost {
  id      String  @id @default(cuid())
  slug    String  @unique
  title   String
  excerpt String? @db.Text
  body    String  @db.Text
  author  String?

  coverImageId String?
  coverImage   StoredFile? @relation("BlogCover", fields: [coverImageId], references: [id])

  publishedAt DateTime @default(now())
  isPublished Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished, publishedAt])
}

// ============================================================
// UPLOADED FILES
// ============================================================

/// Uploaded documents live in Postgres rather than on disk.
///
/// Railway containers have an ephemeral filesystem: anything written to disk is
/// destroyed on the next deploy or restart, so a PDF uploaded by an admin would
/// silently disappear. Storing the bytes in the database keeps them across
/// deploys and inside whatever backup covers the database, with no second
/// account or set of credentials to manage.
///
/// The tradeoff is that this suits documents, not media libraries. If the
/// Association ever publishes video or hundreds of megabytes of scans, move the
/// bytes to object storage - the rest of the code only touches this model
/// through /api/files/[id], so that swap stays contained.
model StoredFile {
  id         String   @id @default(cuid())
  filename   String
  mimeType   String
  sizeBytes  Int
  data       Bytes
  uploadedBy String?
  createdAt  DateTime @default(now())

  publications     Publication[] @relation("PublicationFile")
  blogCovers       BlogPost[]    @relation("BlogCover")
  eventAttachments Event[]       @relation("EventAttachment")
}

model GalleryImage {
  id           String    @id @default(cuid())
  title        String
  category     String
  imageUrl     String
  thumbnailUrl String?
  eventDate    DateTime?
  displayOrder Int       @default(0)

  createdAt DateTime @default(now())

  @@index([category, displayOrder])
}

// ============================================================
// NEWSLETTER (Phase 1)
// ============================================================

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String?
  subscribedAt   DateTime  @default(now())
  unsubscribedAt DateTime?
  source         String?
}
