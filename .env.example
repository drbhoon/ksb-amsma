# ============================================================
# AMSMA - Environment Variables
# Copy to .env.local for dev; set as Railway variables for testing.
#
# For the current Railway test deployment you only need the five variables
# marked [SET NOW]. Everything else can stay unset until its phase arrives.
# ============================================================

# --- Core ---
# [SET NOW] Railway: the public URL Railway gives the service, with https://
# and NO trailing slash. Magic-link review URLs and payment URLs are built from
# this, so if it is wrong the links will point at the wrong host.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database (Postgres) ---
# [SET NOW] On Railway: add a Postgres service and reference its variable:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
# The deploy runs `prisma migrate deploy`, then seeds the 8 committee members.
DATABASE_URL=postgresql://user:password@localhost:5432/amsma?schema=public

# --- Test console ---
# [SET NOW] Guards /dev/links, which lists every application with its committee
# review links and payment link. This is how the flow is tested while email is
# not yet working. Unset = the route 404s.
# Use a long random string - anyone holding it can see applicant data.
DEV_ACCESS_KEY=

# --- Email (Resend) ---
# Outbound email is OFF unless one of the two switches below is set. This is
# deliberate: config/committee-members.ts holds REAL addresses of real people,
# and a stray test application must never mail them.
#
# [SET NOW] Testing - every message goes to these addresses instead of the real
# recipient, with the intended recipient shown in the subject line:
EMAIL_REDIRECT_TO=ksbhoon@rdc.in,drbhoon@gmail.com
#
# Production only - real delivery to real recipients. Do not set while testing.
# EMAIL_LIVE=true
#
# --- Which transport carries the mail ---
# TWO independent gates must both pass before anything is delivered: a mode
# above, AND a provider below. Either one missing means nothing is sent.
#
# Gmail (current) - works without a verified domain, which is what we need
# until amsma.in has DNS. Requires 2-Step Verification on the account, then an
# App Password from https://myaccount.google.com/apppasswords
# Gmail rewrites From to the authenticated account, so FROM_EMAIL is ignored
# while this is active and mail is sent as GMAIL_USER.
GMAIL_USER=amsma2026@gmail.com
GMAIL_APP_PASSWORD=
# Optional display name; defaults to "AMSMA".
FROM_NAME=

# Resend (later) - the long-term answer once amsma.in is hosted and verified,
# for proper SPF/DKIM on the Association's own domain. Gmail takes precedence
# while GMAIL_APP_PASSWORD is set.
RESEND_API_KEY=
FROM_EMAIL=AMSMA <noreply@amsma.in>

# --- Payments ---
# Razorpay is ON HOLD - the Society is still in formation and has no gateway
# account. Leave PAYMENTS_ENABLED unset.
#
# [SET NOW] Lets the pay page record a subscription as paid without a gateway,
# so the Member row, member number and receipt can be tested end to end. The
# Register of Members entry carries a TEST-* reference.
# NEVER set this in production.
TEST_MODE_PAYMENTS=true
#
# When Razorpay is ready: set PAYMENTS_ENABLED=true and fill the keys below.
# Test-mode activation disables itself automatically once real payments are on.
# PAYMENTS_ENABLED=true
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# --- TEMPORARY testing override - REMOVE BEFORE GOING PUBLIC ---
# Rule 4 requires the Proposer and Seconder to be existing members, and while
# the Society is in formation only the 8 founding committee members qualify.
# That leaves testers unable to apply from their own mailbox. These addresses
# are accepted for that check ONLY - they are not committee members, cannot
# vote, and do NOT change the 6-of-8 approval quorum.
# Unset this variable and Rule 4 is enforced again, with no code change.
TEST_PROPOSER_EMAILS=ksbhoon@rdc.in,drbhoon@gmail.com

# --- Auth (NextAuth) - Phase 5, not needed yet ---
NEXTAUTH_SECRET=
NEXTAUTH_URL=
ADMIN_EMAILS=

# --- Cloudflare R2 - Phase 5, not needed yet ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=amsma-uploads
R2_PUBLIC_URL=
