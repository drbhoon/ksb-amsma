# ============================================================
# AMSMA — Environment Variables
# Copy to .env.local for dev; set as Railway variables in prod
# ============================================================

# --- Core ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production: https://amsma.in
NODE_ENV=development

# --- Database (Postgres) ---
# On Railway: add a Postgres service, it auto-populates DATABASE_URL.
# For local dev: use a local Postgres or point to the Railway one.
DATABASE_URL=postgresql://user:password@localhost:5432/amsma?schema=public

# --- Email (Resend) — Phase 1 ---
# Sign up at resend.com, verify amsma.org.in domain, create API key
RESEND_API_KEY=re_xxxxxxxxxxxxx
FROM_EMAIL=AMSMA <noreply@amsma.in>

# --- Auth (NextAuth) — Phase 5 ---
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
# Comma-separated allowlist of admin emails
ADMIN_EMAILS=ksb@amsma.in,secretary@amsma.in,president@amsma.in

# --- Razorpay — Phase 3 ---
# Get keys from dashboard.razorpay.com; use test keys during development
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxx

# --- Cloudflare R2 (S3-compatible object storage) — Phase 5 ---
# Create at dash.cloudflare.com > R2; create API token with Object Read+Write
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=amsma-uploads
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
